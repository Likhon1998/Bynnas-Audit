<IfModule mod_rewrite.c>
    RewriteEngine On

    # cPanel AutoSSL / domain validation must reach .well-known.
    RewriteRule ^\.well-known/ - [L]

    # The root entry script is the only real file served from the project root;
    # .env, storage/, vendor/, database/ etc. must never be reachable directly.
    RewriteRule ^index\.php$ - [L]

    # Everything else goes through /public (needed when docroot is project root).
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

DirectoryIndex index.php public/index.php
Options -Indexes
