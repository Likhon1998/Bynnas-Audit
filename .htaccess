<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not rewrite real files in the project root (e.g. index.php).
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Force all other requests into /public (needed when docroot is project root).
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

DirectoryIndex index.php public/index.php
Options -Indexes
