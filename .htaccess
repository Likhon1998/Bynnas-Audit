<IfModule mod_rewrite.c>
    RewriteEngine On

    # Already inside /public — do nothing.
    RewriteRule ^public/ - [L]

    # Serve existing files/folders from project root (rare).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send everything else into /public (Laravel front controller + assets).
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

DirectoryIndex index.php public/index.php
Options -Indexes
